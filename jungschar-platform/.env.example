# Self-hosted Supabase (bestehend — keinen zweiten Supabase installieren)
# Studio: https://supabase.jungschar-gelterkinden.ch/project/default
# API (wie Notfallblatt): https://app.jungschar-gelterkinden.ch/sb
#   (Auth/REST laufen auch unter https://supabase.jungschar-gelterkinden.ch/…)
NEXT_PUBLIC_SUPABASE_URL=https://app.jungschar-gelterkinden.ch/sb

# Cursor Cloud Secret oder lokaler Wert (nicht committen):
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional (neuere Supabase-Setups)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Postgres (nur für direkte DB-Tools / eCamp DATABASE_URL)
# Auf dem NAS im Docker-Netz:
#   postgresql://postgres:<POSTGRES_PASSWORD>@supabase-db:5432/postgres
# Von ausserhalb / Cursor Cloud (Port 5432 ist offen):
#   postgresql://postgres:<POSTGRES_PASSWORD>@supabase.jungschar-gelterkinden.ch:5432/postgres
# Als Secret bevorzugen: POSTGRES_PASSWORD  ODER  vollständige SUPABASE_DATABASE_URL
# SUPABASE_DATABASE_URL=
# POSTGRES_PASSWORD=

# Test-Account (Supabase Auth): test@example.com / test12
DEMO_AUTH_ENABLED=true

# Module URLs
NEXT_PUBLIC_MODULE_NOTFALLBLATT_URL=https://notfallblatt.jungschar-gelterkinden.ch
NEXT_PUBLIC_MODULE_NEXTCLOUD_URL=https://dateien.jungschar-gelterkinden.ch
# Auf dem NAS mit Nginx-Pfad:
NEXT_PUBLIC_MODULE_ECAMP_URL=https://dev.jungschar-gelterkinden.ch/apps/ecamp

# Docker Nginx HTTP-Port (Host)
HTTP_PORT=8080

# Nur für Profile "tls":
# TLS_CERT_DIR=/etc/letsencrypt/live/dev.jungschar-gelterkinden.ch
