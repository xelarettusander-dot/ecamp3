# Copy to `.env` in the repository root (`.env` is gitignored).
#
# eCamp3 uses Supabase as PostgreSQL only — login stays eCamp JWT/OAuth, not Supabase Auth.
#
# Create a dedicated database in Supabase Studio (e.g. `ecamp3`) before first migrate.
# Use port 5432 for migrations; Supavisor pooler (6543) is optional for runtime only.
#
# Self-hosted Supabase at supabase.jungschar-gelterkinden.ch (ports 5432 and 6543 are open).

SUPABASE_DATABASE_URL=postgresql://postgres:REPLACE_ME@supabase.jungschar-gelterkinden.ch:5432/ecamp3?serverVersion=15&charset=utf8

# If your instance requires TLS, append:
# &sslmode=require
