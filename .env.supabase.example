# Copy to `.env` in the repository root (`.env` is gitignored).
#
# eCamp3 uses Supabase as PostgreSQL only — login stays eCamp JWT/OAuth, not Supabase Auth.
#
# Cursor Cloud Secrets (preferred):
#   POSTGRES_PASSWORD          — Postgres password for user `postgres`
#   SUPABASE_DATABASE_URL      — full connection string (overrides POSTGRES_PASSWORD)
#
# On the NAS Docker network the host is `supabase-db`; from outside use the public host below.

SUPABASE_DATABASE_URL=postgresql://postgres:REPLACE_ME@supabase.jungschar-gelterkinden.ch:5432/postgres?serverVersion=15&charset=utf8

# Or set only the password (start script builds the URL):
# POSTGRES_PASSWORD=REPLACE_ME
# SUPABASE_DB_HOST=supabase.jungschar-gelterkinden.ch
# SUPABASE_DB_NAME=postgres

# If your instance requires TLS, append:
# &sslmode=require
